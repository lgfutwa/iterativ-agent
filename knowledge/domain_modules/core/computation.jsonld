  "@id": "core.computation",
  "name": "core.computation",
  "description": "Software systems, code execution, and state changes.",
  "concepts": [
    {
      "@id": "core.computation.tool_execution",
      "name": "Tool Execution",
      "definition": "A bounded operation performed by an agent tool with arguments, result, duration, and provenance."
    },
    {
      "@id": "core.computation.state_store",
      "name": "State Store",
      "definition": "A persistence surface that records sessions, messages, graph nodes, or derived knowledge."
    },
    {
      "@id": "core.computation.skill",
      "name": "Skill",
      "definition": "A reusable procedural transform that can require and produce knowledge claims."
    }
  ],
  "relationships": [
    {
      "source": "core.computation.skill",
      "predicate": "produced_by",
